@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "ثبت نام کاربر جدید";
    Layout = "~/Areas/Reporter/Views/Shared/_Layout.cshtml";
}
<style>
       .topleft {
        position: absolute;
        top: 8px;
        left: 16px;
        font-size: 18px;
    }

    .downright {
        position: absolute;
        bottom: 8px;
        right: 16px;
        font-size: 18px;
    }
</style>

<div class="content-wrapper">
    <div class="container-fluid">
        <!-- Zero configuration table -->
        <section id="configuration">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title-wrap bar-success">
                                <h4 class="card-title">لیست خبر های من</h4>
                            </div>
                        </div>
                        <div class="card-body collapse show">
                            <div class="card-block card-dashboard">
                                <div id="DataTables_Table_0_wrapper" class="dataTables_wrapper container-fluid dt-bootstrap4">
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <div class="dataTables_length" id="">
                                                <label>
                                                    نمایش
                                                    <select name="DataTables_Table_0_length" id="DataTables_Table_0_length" aria-controls="DataTables_Table_0" class="form-control form-control-sm" onchange="GetNews(1);">
                                                        <option class="items" value="5">5</option>
                                                        <option class="items" value="10">10</option>
                                                        <option class="items" value="25">25</option>
                                                        <option class="items" value="50">50</option>
                                                    </select> سطر
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div id="DataTables_Table_0_filter" class="dataTables_filter">
                                                <label>جستجو:<input id="SearchKye" class="form-control form-control-sm" type="text" placeholder="Search.."></label>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div id="DataTables_Table_0_filter" class="dataTables_filter">
                                                <label>
                                                     وضعیت خبر:
                                                    <select name="Filter" id="Filter" aria-controls="DataTables_Table_0" placeholder="همه" class="form-control form-control-sm" onchange="GetNews(1);">
                                                        <option class="items">همه</option>
                                                        <option class="items" value="1">تایید شده</option>
                                                        <option class="items" value="2">برسی نشده</option>
                                                        <option class="items" value="3">رد شده</option>
                                                    </select>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div style="width:100%; overflow:auto" class="col-sm-12">
                                            
                                            <table class="table table-striped table-hover table-bordered zero-configuration dataTable" id="DataTables_Table_0" role="grid" aria-describedby="DataTables_Table_0_info">
                                                <thead>
                                                    <tr>
                                                        <th>تصویر پیش فرض</th>
                                                        <th>عنوان خبر</th>
                                                        <th>گروه خبری</th>
                                                        <th>وضعیت</th>
                                                        <th>تاریخ ثبت</th>
                                                        <th>دکمه های کمکی</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="MyTabel"></tbody>
                                            </table>

                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-12 col-md-5">
                                            <div class="dataTables_info" id="text_shit" role="status" aria-live="polite">
                                            </div>
                                        </div>
                                        <div class="col-sm-12 col-md-7">
                                            <div class="dataTables_paginate paging_simple_numbers" id="DataTables_Table_0_paginate"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>



@section Modals{
<!-- Modal Edit News -->
<div class="modal fade" id="EditNews" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog" role="document" style="max-width:80%">
        <div class="modal-content">
            <div class="modal-header">
                <div class="col-xl-12 col-lg-12 col-md-12 mb-1">
                    <h1>ویرایش خبر</h1>
                </div>
            </div>
            <div class="modal-body row h3" style="margin: 1%;">
                <div class="col-xl-4 col-lg-6 col-md-12 mb-1">
                    <fieldset class="form-group">
                        <label for="">عنوان</label>
                        <input type="text" class="form-control" id="Edit_Title" name="Edit_Title">
                    </fieldset>
                </div>
                <div class="col-xl-4 col-lg-6 col-md-12 mb-1">
                    <fieldset class="form-group">
                        <label for="basicInput">گروه خبری</label>
                        <div class="">
                            <select style="width:100%;" class="form-control chosen-select" id="Edit_Category" name="Category" asp-items="@ViewBag.Category" >
                                
                            </select>
                        </div>
                    </fieldset>
                </div>
                <div class="col-xl-12 col-lg-12 col-md-12 mb-1">
                    <fieldset class="form-group">
                        <label for="">سر تیتر</label>
                        <input type="text" class="form-control" id="Edit_Headline" name="Edit_Headline">
                    </fieldset>
                </div>
                <div class="col-xl-12 col-lg-12 col-md-12 mb-1">
                    <fieldset class="form-group">
                        <label for="">متن خبر</label>
                        <textarea rows="10" class="form-control" id="Edit_Body" name="Edit_Body"></textarea>
                    </fieldset>
                </div>
                <div class="col-md-12">
                    <div class="form-group">
                        <button class="btn btn-info" onclick="$('#EditFileImg').click()"><i class="fa fa-plus"> افزودن عکس به خبر</i></button>
                        <input id="EditFileImg" type="file" class="form-control btn btn-accent-2 p2" oninput="AddImage()" hidden>
                        <div id="Edit_FileDocuments" class="row" style="margin: 1%;"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-secondary" id="Shutdown" onclick="$('#EditNews').modal('hide');">بستن</a>
                <button id="EditNewsBtn" class="btn btn-primary">اعمال تغییرات</button>
            </div>
        </div>
    </div>
</div>


<!-- Modal News View -->
<div class="modal fade" id="NewsView" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog" role="document" style="max-width:80%">
        <div class="modal-content">

            <div class="modal-header">
                <div class="col-xl-6 col-lg-6 col-md-6 mb-1">
                    <h1 id="modal_WiewNews_CategoryTitle"></h1>
                </div>
                <div class="col-xl-6 col-lg-6 col-md-6 mb-1">
                    <h1 class="modal-title h2" style="padding:1%;" id="modal_WiewNews_Title"></h1>
                </div>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-xl-8 col-lg-8 col-md-8 mb-1">
                        <p class="h3" id="modal_WiewNews_Headline"></p>
                    </div>
                    <div class="col-xl-4 col-lg-4 col-md-4 mb-1" style="max-height:350px">
                        <img alt="خبر دارای تصویر نماییه نمی باشد" id="modal_WiewNews_DefaultImage" class="img-thumbnail rounded mx-auto" style="text-align:center;height:100%;width:100%object-fit:cover;" />
                    </div>
                </div>
                <div class="col-xl-12 col-lg-12 col-md-12 mb-1">
                    <p class="h4" id="modal_WiewNews_Body"></p>
                </div>
                <div class="">
                    <p class="h3" id="modal_WiewNews_InsertTime"></p>
                </div>
                <div class="col-xl-12 col-lg-12 col-md-12 mb-1">
                    <div class="form-group">
                        <div id="modal_WiewNews_FileDocuments" class="row" style="margin: 1%;"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-primary" id="Shutdown" onclick="$('#NewsView').modal('hide');">بستن</a>
            </div>

        </div>
    </div>
</div>
}



@section Scripts
{
<script>

    var ImagesId = [];
    var page = 1;
    GetCategories()
    .then(function(isConfirm){
        GetNews(page);
    });

    $(document).ready(function(){

        $('.act').removeClass("active");
        $('.act-index').addClass("active");

       //shearch:
       $("#SearchKye").on("keyup", function() {
          var value = $(this).val().toLowerCase();
          $("#MyTabel tr").filter(function() {
              $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
          });
       });

    });


    //****************************** functions ******************************

        function setPagination(recordCount, itemsOnPage, currentPage){
            var items = ( recordCount / $("#DataTables_Table_0_length").val() );
            $("#DataTables_Table_0_paginate").pagination({
                items: items,
                itemsOnPage: 1,
                currentPage: currentPage,
                cssStyle: 'light-theme',
                prevText: "قبلی",
                nextText: "بعدی",
                onPageClick : function(pageNumbner, event){
                    page = pageNumbner;
                    GetNews(page);
                },
            });
            var text = "<p> نمایش " + (itemsOnPage*(currentPage-1)+1) +" تا ";
            text += (itemsOnPage*currentPage) > recordCount ? recordCount : (itemsOnPage*currentPage);
            text += " از "+recordCount+"سطر <p>";
            $("#text_shit").html(text);
        }


        function GetNews(p){
            var datapost ={
                Filter : $("#Filter").val(),
                page : p,
                pagesize : $("#DataTables_Table_0_length").val(),
            };
            debugger
            var url='/Reporter/News/GetMyNews';
            $.post(url,{request:datapost},function(result){
                $('#DataTables_Table_0 tbody tr').remove();
                setPagination(result.recordCount,datapost.pagesize,p);
                for(var i=0;i<result.data.length;i++)
                {
                    var tr="";
                    tr+='<tr>';
                    tr+='<td>';
                    if(result.data[i].defaultImageId != null) { tr+=`<div style="height: 100px; width: 100px;"><a href="/FileDacuments/GenerateFile?fileDocumentId=${result.data[i].defaultImageId}" target="_blank"><img src="/FileDacuments/GenerateFile?fileDocumentId=${result.data[i].defaultImageId}" class="img-thumbnail rounded-circle mx-auto" style="text-align: center;height:100%;width:100%"></a></div>`; }
                    else {tr+=`<div style="height: 100px; width: 100px;"><img src="/Express_New/images/no-image.png" class="img-thumbnail rounded-circle mx-auto" style="text-align: center;height:100%;width:100%"></div>`; }
                    tr+='</td>';
                    tr+='<td>'+result.data[i].title+'</td>';
                    tr+='<td>'+result.data[i].categoryTitle+'</td>';
                    if(result.data[i].isRemove){
                        tr+='<td class="text-danger">حذف شده</td>';
                    }
                    else if(result.data[i].isActive == null){
                        if(result.data[i].read == true) {tr+='<td class="text-primary">برسی نشده (مشاهده شده)</td>';}
                        else {tr+='<td class="text-primary">برسی نشده (در انتظار مشاهده)</td>';}

                    }
                    else if(result.data[i].isActive){
                        tr+='<td class="text-success">تایید شده</td>';
                    }
                    else{
                        tr+='<td class="text-warning">رد شده</td>';
                    }
                    tr+='<td>'+result.data[i].insertTime+'</td>';
                    tr+='<td>';
                    if(result.data[i].isActive != true)
                    {
                        if (result.data[i].isActive == false)
                        {
                            tr+=`<button onclick="AdminReasons('${result.data[i].reasons}', ${result.data[i].id})" class="btn btn-warning ml-2">دلایل رد خبر</button>`;
                            tr+=`<button onclick="ShowEditModal(${result.data[i].id})" class="btn btn-info ml-2">ویرایش خبر</button>`;
                        }
                        else if(result.data[i].read == false)
                        {
                            tr+=`<button onclick="ShowEditModal(${result.data[i].id})" class="btn btn-info ml-2">ویرایش خبر</button>`;
                        }
                        tr+=`<button onclick="Delete(${result.data[i].id})" class="btn btn-danger ml-2">حذف خبر</button>`;
                    }
                    tr+=`<button onclick="ShowReadModal(${result.data[i].id})" class="btn btn-primary ml-2">مشاهده خبر</button>`;
                    tr+='</td>';
                    tr+='</tr>';
                    $('#DataTables_Table_0 tbody').append(tr);
                }
            });
        }


        function AdminReasons(Reasons, id){
            swal.fire({
                title:'دلایل رد خبر',
                text: Reasons,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: 'info ',
                cancelButtonColor: '#22f',
                confirmButtonText: 'ویرایش خبر',
                cancelButtonText: 'بستن'
            })
            .then((result) => {
                if(result.value) {
                    ShowEditModal(id);
                 }
            });
        }


        function Delete(id){
            swal.fire({
                title: 'حذف خبر',
                text: 'آیا می خواهید حذف خبر را انجام دهید؟',
                icon: 'info',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'بله حذف خبر انجام شود',
                cancelButtonText: 'خیر'
            })
            .then((result) => {
                if(result.value) {
                    var url='/Reporter/News/Delete';
                    $.post(url,{id:id},function(data){
                        if(data.isSuccess){
                            swal.fire('موفق',data.message,'success');
                            GetNews(page);
                        }
                        else{
                            swal.fire('هشدار',data.message,'warning');
                        }
                    });
                 }
            });
        }


        function ShowReadModal(id){
            var url='/Reporter/News/ReadNews';
            $.post(url,{id:id},function(result){
                if(result.isSuccess){
                    $('#modal_WiewNews_DefaultImage').attr('src',`/FileDacuments/GenerateFile?fileDocumentId=${result.data.defaultImageId}`);
                    $('#modal_WiewNews_Title').text(`${result.data.title}`);
                    $('#modal_WiewNews_Headline').text(`${result.data.headline}`);
                    $('#modal_WiewNews_Body').html(`${result.data.body.replaceAll('\n', '<br>')}`);
                    $('#modal_WiewNews_InsertTime').text(`${result.data.EditTime ?? result.data.insertTime}`);
                    $('#modal_WiewNews_CategoryTitle').text(`${result.data.categoryTitle}`);
                    $('#NewsView').modal('show');
                    $('#modal_WiewNews_FileDocuments').empty();
                    for(var i=0;i<result.data.imagesId.length;i++)
                    {
                        if(result.data.defaultImageId != result.data.imagesId[i])
                        ReadGetImage(result.data.imagesId[i]);
                    }
                }
                else{
                    swal.fire('هشدار',result.message,'warning');
                }
            });
        }


        function GetCategories(){
            return new Promise((rsolve)=>{
                var url = "/Reporter/News/GetCategories";
                $.post(url,function(result){
                    var option = "";
                    for(var i=0;i<result.data.categories.length;i++)
                    {
                        option += `<option value="${result.data.categories[i].id}">${result.data.categories[i].title}</option>`;
                    }
                    $('#Edit_Category').html(option).trigger("chosen:updated");
                    rsolve();
                });
            });
        }


        function ShowEditModal(id){
            var url='/Reporter/News/ShowEditModal';
            $.post(url,{id:id},function(result){
                if(result.isSuccess){
                    var DifaultImageId = result.data.defaultImageId;
                    $('#Edit_Title').val(`${result.data.title}`);
                    $('#Edit_Headline').val(`${result.data.headline}`);
                    $('#Edit_Body').val(`${result.data.body}`);
                    debugger
                        $("#Edit_Category").val(result.data.categoryId);

                    $('#EditNews').modal('show');
                    $('#EditNewsBtn').on('click', function(){ Edit(id); });
                    $('#Edit_FileDocuments').empty();
                    ImagesId = [];
                    for(var i=0;i<result.data.imagesId.length;i++)
                    {
                        EditGetImage(result.data.imagesId[i]);
                    }
                    for(var i = 0; i < document.getElementsByName('radio').length; i++)
                    {
                        if(document.getElementsByName('radio')[i].defaultValue == DifaultImageId)
                        {
                             document.getElementsByName('radio')[i].checked = true;
                        }
                    }
                }
                else{
                    swal.fire('هشدار',result.message,'warning');
                }
            });
        }
        

        function Edit(id){
            swal.fire({
                title: 'ویرایش خبر',
                text: `آیا از ویرایش خبر اطمینان دارید؟`,
                icon: 'info',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'بله انجام شود',
                cancelButtonText: 'خیر'
            })
            .then((result) => {
                if(result.value) {
                    var DifaultImageId;
                    var DifaultImage = document.getElementsByName('radio');
                    for(var i = 0; i < DifaultImage.length; i++)
                    {
                        if(DifaultImage[i].checked )
                        {
                            DifaultImageId = DifaultImage[i].defaultValue;
                        }
                    }

                    var postdata = {
                       'Id': id,
                       'Title': $("#Edit_Title").val(),
                       'Headline': $("#Edit_Headline").val(),
                       'Body': $("#Edit_Body").val(),
                       'CategoryId': $("#Edit_Category").val(),
                       'DefaultImageId': DifaultImageId,
                       'FileDocuments': ImagesId,
                    };

                    var url = "/Reporter/News/EditNews";
                    $.post(url,postdata,function(result){
                        if(result.isSuccess){
                            GetNews(page);
                            $('#EditNews').modal('hide');
                        }
                        else{
                            swal.fire('هشدار',result.message,'warning');
                        }
                    });
                }
            });
        }

     //****************************** Image ******************************

        function AddImage(){
            let fileUpload = $("#EditFileImg").get(0);
            let files = ((fileUpload) ? fileUpload.files : null);
            let fileToBeUoload = ((files) ? files[0] : null);
            let inputmodel = new FormData();

            inputmodel.append("File", fileToBeUoload);

            $.ajax({
                contentType:'application/x-www-form-urlencoded',
                dataType:'json',
                type:'POST',
                url:'/FileDacuments/Createfile',
                data:inputmodel,
                processData:false,
                contentType:false,
                success:function(result){
                    if(result.isSuccess){
                        EditGetImage(result.data);
                    }
                    else{
                        swal.fire('هشدار',result.message,'warning');
                    }
                },
                erroe:function(request, status, error){
                    alert('error');
                }
            });
        }


        function EditGetImage(id){
            var img = "";
            img += `<div id="${id}" style="width:210px; height:210px; float:left; position: relative;">
                <a href="/FileDacuments/GenerateFile?fileDocumentId=${id}" target="_blank">
                <img onclick="/FileDacuments/GenerateFile?fileDocumentId=${id}" target="_blank"
                src="/FileDacuments/GenerateFile?fileDocumentId=${id}"
                class="img-thumbnail rounded mx-auto"style="text-align: center;height:100%;width:100%"></a>
                <div class="topleft"><button class="btn-sm btn-danger" onclick="RemoveImage('${id}')">
                <i class="fa fa-trash"></i></button></div>
            <input class="downright" type="radio" value="${id}" name="radio"></div>`;
            ImagesId.push(id);
            $('#Edit_FileDocuments').append(img);
        }


        function ReadGetImage(id){
            var img = "";
            img += `<div id="${id}" style="width:210px; height:210px; float:left; position:relative; margin-left:1%">
                <img onclick="/FileDacuments/GenerateFile?fileDocumentId=${id}" target="_blank"src="/FileDacuments/GenerateFile?fileDocumentId=${id}"
            class="img-thumbnail rounded mx-auto"style="text-align: center;height:100%;width:100%"></div>`;
            $('#modal_WiewNews_FileDocuments').append(img);
        }


        function RemoveImage(id){
            var url='/FileDacuments/RemoveFile';
            $.post(url,{id:id},function(data){
                if(data.isSuccess){
                    $(`#${id}`).remove();
                    ImagesId = ImagesId.filter(a=>a!=id);
                }
                else{
                    swal.fire('هشدار',data.message,'warning');
                }
            });
        }
</script>
}