@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using NewsWebSite.Common.Dto.News;
@{
    ViewData["Title"] = "ثبت نام کاربر جدید";
    Layout = "~/Areas/Reporter/Views/Shared/_Layout.cshtml";
}

@*<link rel="stylesheet" type="text/css" href="/ckEditor/ckeditor.js.map">
<script src="/ckEditor/ckeditor.js"></script>
<script src="/ckEditor/MyCk5.js"></script>*@

<style>
    .topleft {
        position: absolute;
        top: 8px;
        left: 16px;
        font-size: 18px;
    }

    .downright {
        position: absolute;
        bottom: 8px;
        right: 16px;
        font-size: 18px;
    }
</style>

<section class="basic-elements">
    <div class="row">
        <div class="col-sm-12">
            <h2 class="content-header">فرم ثبت خبر جدید</h2>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card" style="margin: 15px 15px;">
                <div class="card-header">
                    <div class="card-title-wrap bar-success">
                        <h4 class="card-title mb-0">اطلاعات خبر جدید را وارد نمایید</h4>
                    </div>
                </div>
                <div class="">
                    <div class="px-3">
                        <div class="form-body">
                            <div class="row">

                                <div class="col-xl-4 col-lg-6 col-md-12 mb-1">
                                    <fieldset class="form-group">
                                        <label for="">عنوان</label>
                                        <input type="text" class="form-control" id="Title" name="Title">
                                    </fieldset>
                                </div>
                                <div class="col-xl-4 col-lg-6 col-md-12 mb-1">
                                    <fieldset class="form-group">
                                        <label for="basicInput">گروه خبری</label>
                                        <div class="">
                                            <select style="width:100%;" class="form-control chosen-select" id="Category" name="Category" asp-items="@ViewBag.Categories">
                                                <option value="">انتخاب کنید</option>
                                            </select>
                                        </div>
                                    </fieldset>
                                </div>
                                <div class="col-xl-12 col-lg-12 col-md-12 mb-1">
                                    <fieldset class="form-group">
                                        <label for="">سر تیتر</label>
                                        <input type="text" class="form-control" id="Headline" name="Headline">
                                    </fieldset>
                                </div>
                                <div class="col-xl-12 col-lg-12 col-md-12 mb-1">
                                    <fieldset class="form-group">
                                        <label for="">متن خبر</label>
                                        <textarea rows="10" class="form-control" id="Body" name="Body"></textarea>
                                        @*<textarea id="Body" name="Body">&lt;p&gt;Initial value.&lt;/p&gt;</textarea>*@
                                    </fieldset>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <button class="btn btn-info" onclick="$('#fileImg').click()"><i class="fa fa-plus"> افزودن عکس به خبر</i></button>
                                        <input id="fileImg" type="file" class="form-control btn btn-accent-2" oninput="AddImage()" hidden>
                                        <div id="FileDocuments" class="row p-2"></div>
                                    </div>
                                </div>
                                <div class="col-xl-12 col-lg-12 col-md-12 mb-1">
                                    <fieldset class="form-group">
                                        <br />
                                    </fieldset>
                                </div>
                                <button onclick="Create()" class="btn btn-success col-md-12">تکمیل ثبت نام </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



@section Scripts {
<script>
    //CKEDITOR.replace( 'Body' );
    $(document).ready(function(){
        $('.act').removeClass("active");
        $('.act-create').addClass("active");
    });

    // ****************************** Image ******************************

    function AddImage(){
        let fileUpload = $("#fileImg").get(0);
        let files = ((fileUpload) ? fileUpload.files : null);
        let fileToBeUoload = ((files) ? files[0] : null);
        let inputmodel = new FormData();

        inputmodel.append("File", fileToBeUoload);

        $.ajax({
            contentType:'application/x-www-form-urlencoded',
            dataType:'json',
            type:'POST',
            url:'/FileDacuments/Createfile',
            data:inputmodel,
            processData:false,
            contentType:false,
            success:function(result){
                if(result.isSuccess){
                    GetImage(result.data);
                }
                else{
                    swal.fire('هشدار',result.message,'warning');
                }
            },
            erroe:function(request, status, error){
                alert('error');
            }
        });
    }


    var ImagesId = [];
    function GetImage(id){
        var img = "";
        img += `
        <div id="${id}" class="mr-1" style="width:210px; height:210px; float:left; position: relative;">
            <a href="/FileDacuments/GenerateFile?fileDocumentId=${id}" target="_blank">
                <img onclick="/FileDacuments/GenerateFile?fileDocumentId=${id}" target="_blank" src="/FileDacuments/GenerateFile?fileDocumentId=${id}" class="img-thumbnail rounded mx-auto"style="text-align: center;height:100%;width:100%">
            </a>
            <div class="topleft">
                <button class="btn-sm btn-danger" onclick="RemoveImage('${id}')">
                    <i class="fa fa-trash"></i>
                </button>
            </div>
            <input class="downright" type="radio" value="${id}" name="radio">
        </div>
        `;
        ImagesId.push(id);
        $('#FileDocuments').append(img);
    }


    function RemoveImage(id){
        var url='/FileDacuments/RemoveFile';
        $.post(url,{id:id},function(data){
            if(data.isSuccess){
                $(`#${id}`).remove();
               ImagesId=ImagesId.filter(a=>a!=id)
            }
            else{
                swal.fire('هشدار',data.message,'warning');
            }
        });
    }

    // ****************************** Add ******************************

    function Create(){
        var DifaultImageId;
        var DifaultImage = document.getElementsByName('radio');
        for(var i = 0; i < DifaultImage.length; i++)
        {
            if(DifaultImage[i].checked )
            {
                DifaultImageId = DifaultImage[i].defaultValue;
            }
        }

        var postData = {
            'Title': $("#Title").val(),
            'Headline': $("#Headline").val(),
            'Body': $("#Body").val(),
            'CategoryId': $("#Category").val(),
            'DefaultImageId': DifaultImageId,
            'FileDocuments': ImagesId,
        };

        //var postData = {};
        //postData.Title = $("#Title").val();
        //postData.Headline = $("#Headline").val();
        //postData.Body = $("#Body").val();
        //postData.CategoryId = $("#Category").val();
        //postData.DefaultImageId = DifaultImageId;
        //postData.FileDocuments = ImagesId;

        var url = "/Reporter/News/Create"
        $.post(url,{request:postData},function(result){
            if(result.isSuccess){
                swal.fire('موفق',result.message,'success').
                    then(function (isConfirm){
                    location.reload();
                });
            }
            else{
                swal.fire('هشدار',result.message,'warning');
            }
        });
    }
</script>
}