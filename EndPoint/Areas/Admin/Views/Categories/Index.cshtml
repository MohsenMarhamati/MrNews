@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using NewsWebSite.Common.Dto.Category;
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="container-fluid">
        <!-- Zero configuration table -->
        <section id="configuration">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title-wrap bar-success">
                                <h4 class="card-title">لیست گروه های خبری</h4>
                            </div>
                        </div>
                        <div class="card-body collapse show">
                            <div class="card-block card-dashboard">
                                <div id="DataTables_Table_0_wrapper" class="dataTables_wrapper container-fluid dt-bootstrap4">
                                    <div class="row">
                                        <div class="col-sm-12 col-md-6">
                                            <div class="dataTables_length" id="">
                                                <label>
                                                    نمایش
                                                    <select name="DataTables_Table_0_length" id="DataTables_Table_0_length" aria-controls="DataTables_Table_0" class="form-control form-control-sm" onchange="GetCategories(1);">
                                                        <option class="items" value="5">5</option>
                                                        <option class="items" value="10">10</option>
                                                        <option class="items" value="25">25</option>
                                                        <option class="items" value="50">50</option>
                                                    </select> سطر
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-sm-12 col-md-6">
                                            <div id="DataTables_Table_0_filter" class="dataTables_filter">
                                                <label>جستجو:<input id="SearchKye" class="form-control form-control-sm" type="text" placeholder="Search.."></label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div style="width:100%; overflow:auto" class="col-sm-12">

                                            <table class="table table-striped table-hover table-bordered zero-configuration dataTable" id="DataTables_Table_0" role="grid" aria-describedby="DataTables_Table_0_info">
                                                <thead>
                                                    <tr>
                                                        <th>تصویر</th>
                                                        <th>عنوان</th>
                                                        <th>کد گروه خبری</th>
                                                        <th>دکمه های کمکی</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="MyTabel"></tbody>
                                            </table>

                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-12 col-md-5">
                                            <div class="dataTables_info" id="text_shit" role="status" aria-live="polite">
                                            </div>
                                        </div>
                                        <div class="col-sm-12 col-md-7">
                                            <div class="dataTables_paginate paging_simple_numbers" id="DataTables_Table_0_paginate"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>



@section Modals{
<!-- Modal Edit Category -->
<div class="modal fade" id="EditCategory" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">ویرایش گروه خبری</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-xl-12 col-lg-12 col-md-12 mb-1">
                    <fieldset class="form-group">
                        <label class="h4" for="">تصویر</label>
                        <br />
                        <img class="img-thumbnail col-12 rounded" id="Edit_CategoryImage" onclick="$('#FileEdit').click()" style="text-align:center;max-height:400px;">
                        <input type="file" class="form-control" id="FileEdit"  name="fileEdit" onchange="UploadImage()" hidden>
                    </fieldset>
                </div>
                <div class="col-xl-12 col-lg-12 col-md-12 mb-1">
                    <fieldset class="form-group">
                        <label class="h4" for="basicInput">نام</label>
                        <input type="text" class="form-control" id="Edit_CategoryName">
                    </fieldset>
                </div>
                <div class="col-xl-12 col-lg-12 col-md-12 mb-1">
                    <fieldset class="form-group">
                        <label class="h4" for="basicInput">عنوان</label>
                        <input type="text" class="form-control" id="Edit_CategoryTitle">
                    </fieldset>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-secondary" data-dismiss="modal">بستن</a>
                <button id="EditCategoryBtn" class="btn btn-primary">اعمال تغییرات</button>
            </div>
        </div>
    </div>
</div>
}



@section Scripts
{
<script>
    var page = 1;
    GetCategories(1);

    $(document).ready(function(){

        $('.act').removeClass("active");
        $('.cat-index').addClass("active");

       //shearch:
       $("#SearchKye").on("keyup", function() {
          var value = $(this).val().toLowerCase();
          $("#MyTabel tr").filter(function() {
              $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
          });
       });

    });


        /**************** functions ****************/


        function setPagination(recordCount, itemsOnPage, currentPage){
            var items = ( recordCount / $("#DataTables_Table_0_length").val() );
            $("#DataTables_Table_0_paginate").pagination({
                items: items,
                itemsOnPage: 1,
                currentPage: currentPage,
                cssStyle: 'light-theme',
                prevText: "قبلی",
                nextText: "بعدی",
                onPageClick : function(pageNumbner, event){
                    page = pageNumbner;
                    GetCategories(page);
                },
            });
            var text = "<p> نمایش " + (itemsOnPage*(currentPage-1)+1) +" تا ";
            text += (itemsOnPage*currentPage) > recordCount ? recordCount : (itemsOnPage*currentPage);
            text += " از "+recordCount+"سطر <p>";
            $("#text_shit").html(text);
        }


        function GetCategories(p){
            var datapost ={
                page : p,
                pagesize : $("#DataTables_Table_0_length").val(),
            }
            var url='/Admin/Categories/GetCategories';
            $.post(url,datapost,function(result){
                $('#DataTables_Table_0 tbody tr').remove();
                setPagination(result.data.recordCount,datapost.pagesize,p);
                for(var i=0;i<result.data.categories.length;i++)
                {
                    var tr="";
                    tr+=`<tr>
                        <td>
                            <div style="height: 100px; width: 100px;">`
                            if(result.data.categories[i].fileDocumentId != null){
                                tr+=`<a href="/FileDacuments/GenerateFile?fileDocumentId=result.data.categories[i].fileDocumentId}" target="_blank">
                                   <img src="/FileDacuments/GenerateFile?fileDocumentId=${result.data.categories[i].fileDocumentId}" class="img-thumbnail rounded-circle mx-auto" style="text-align: center;height:100%;width:100%">
                                </a>`
                            }
                            else { tr+=`<div style="height: 100px; width: 100px;"><img src="/Express_New/images/no-image.png" class="img-thumbnail rounded-circle mx-auto" style="text-align: center;height:100%;width:100%"></div>`; }
                    
                            tr+=`</div>
                        </td>
                        <td>${result.data.categories[i].title}</td>
                        <td>${result.data.categories[i].id}</td>
                        <td>
                            <button onclick="ShowModelEditCategory(${result.data.categories[i].id})" class="btn btn-info ml-2">ویرایش</button>
                            <button onclick="DeleteCategory(${result.data.categories[i].id})" class="btn btn-danger ml-2">حذف</button>
                        </td>
                    </tr>`;
                    $('#DataTables_Table_0 tbody').append(tr);
                }
            });
        }


        function DeleteCategory(id){
            swal.fire({
                titel: 'حذف گروه خبری',
                text: 'آیا می خواهید حذف گروه خبری را انجام دهید؟',
                icon: 'info',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'بله حذف انجام شود',
                cancelButtonText: 'خیر'
            })
            .then((result) => {
                if(result.value) {
                    var url='/Admin/Categories/DeleteCategory';
                    $.post(url,{id:id},function(data){
                        if(data.isSuccess){
                            swal.fire('موفق',data.message,'success');
                            GetCategories(page);
                        }
                        else{
                            swal.fire('هشدار',data.message,'warning');
                        }
                    });
                 }
            });
        }


        function CategorySatusChange(id){
            var taxt = $("#IsActive").val();
            swal.fire({
                titel: 'حذف کاربر',
                text: `آیا از ${taxt} اطمینان دارید؟`,
                icon: 'info',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'بله انجام شود',
                cancelButtonText: 'خیر'
            })
            .then((result) => {
                if(result.value) {
                    var url='/Admin/Categories/CategorySatusChange';
                    $.post(url,{id:id},function(data){
                        if(data.isSuccess){
                            swal.fire('موفق',data.message,'success');
                            GetCategories(page);
                        }
                        else{
                            swal.fire('هشدار',data.message,'warning');
                        }
                    });
                }
            });
        }


        function ShowModelEditCategory(id){
            var url='/Admin/Categories/FindCategory';
            $.post(url,{id:id},function(result){
                if(result.isSuccess){
                    if(result.data.fileDocumentId == null){$('#Edit_CategoryImage').attr('src',`"/Express_New/images/no-image.png"`);}
                    else{$('#Edit_CategoryImage').attr('src',`/FileDacuments/GenerateFile?fileDocumentId=${result.data.fileDocumentId}`);} 
                    $('#Edit_CategoryName').val(`${result.data.name}`);
                    $('#Edit_CategoryTitle').val(`${result.data.title}`);
                    $('#EditCategoryBtn').on('click', function(){EditCategory(id);});
                    $('#EditCategory').modal('show');
                }
                else{
                    swal.fire('هشدار',result.message,'warning');
                }
            })
        }


        function EditCategory(id){
            swal.fire({
                titel: 'ویرایش گروه خبری',
                text: `آیا از ویرایش گروه خبری اطمینان دارید؟`,
                icon: 'info',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'بله انجام شود',
                cancelButtonText: 'خیر'
            })
            .then((result) => {
                if(result.value) {
                    let fileUpload = $("#FileEdit").get(0);
                    let files = ((fileUpload) ? fileUpload.files : null);
                    let fileToBeUoload = ((files) ? files[0] : null);
                    let inputmodel = new FormData();

                    inputmodel.append("File", fileToBeUoload);
                    inputmodel.append("Id", id);
                    inputmodel.append("Name", $("#Edit_CategoryName").val());
                    inputmodel.append("Title", $("#Edit_CategoryTitle").val());

                    $.ajax({
                        contentType:'application/x-www-form-urlencoded',
                        dataType:'json',
                        type:'POST',
                        url:'EditCategory',
                        data:inputmodel,
                        processData:false,
                        contentType:false,
                        success:function(data){
                            if(data.isSuccess){
                                swal.fire('موفق',data.message,'success').
                                    then(function (isConfirm){
                                    location.reload();
                                });
                            }
                            else{
                                swal.fire('هشدار',data.message,'warning');
                            }
                        },
                        erroe:function(request, status, error){
                            alert('error');
                        }
                    });
                }
            });
        }


        function UploadImage(){
           $('#Edit_CategoryImage').attr('src', URL.createObjectURL($('#FileEdit').get(0).files[0]));
        }   
</script>
}


