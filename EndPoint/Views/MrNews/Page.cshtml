@model long

@{
    ViewData["Title"] = "NewsPage";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

@section Css {
<style>
    .Reply {
        padding: 1px;
        padding-bottom: 2px;
        display: none;
    }
</style>
}

<div class='panel panel-body'>
    <header>
        <ol class="breadcrumb col-xl-12 col-lg-12 col-md-12 mb-1">
            <li><a href="/">صفحه اصلی</a></li>
            <li><a id="CategoryTitle"></a></li>
        </ol>
    </header>
    <div id="100" class="col-xl-12 col-lg-12 col-md-12 mb-12 row">
        <div class="col-6 col-sm-6 col-md-6 col-sm-6 col-lg-6 col-xl-6 col-xxl-6">
            <p class="h3" id="InsertTime"></p>
        </div>
        <div class="col-6 col-sm-6 col-md-6 col-sm-6 col-lg-6 col-xl-6 col-xxl-6 row">
            <div class="col-6 col-sm-6 col-md-6 col-sm-6 col-lg-6 col-xl-6 col-xxl-6">
                <button class="btn" style="background-color:#fff;" onclick="ShowRateModal()">

                    <span id="MyRate" style="font-size:xx-large;"></span>
                    <i id="SolidStar" class="fa-regular fa-star" aria-hidden="true" style="color:#101edf;font-size:x-large;"></i>
                </button>
            </div>
            <div class="col-6 col-sm-6 col-md-6 col-sm-6 col-lg-6 col-xl-6 col-xxl-6 row">
                    <span id="LikeCount"></span>
                    <span id="Rateing" style="font-size:xx-large;"></span>
                    <i class="fa-solid fa-star" aria-hidden="true" style="color:#ffd600;font-size:x-large;"></i>
            </div>
        </div>
        <div class="col-xl-12 col-lg-12 col-md-12 mb-1">
            <h1 class="modal-title" id="Title"></h1>
        </div>
        <div class="body">
            <div class="row">
                <div class="col-xl-8 col-lg-8 col-md-8 mb-1">
                    <p class="h3" id="Headline"></p>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-4 mb-1">
                    <img alt="خبر دارای تصویر نماییه نمی باشد" id="DefaultImage" class="img-thumbnail rounded mx-auto" style="text-align:center;max-height:250px;height:100%;width:100%" />
                </div>
                <div class="col-xl-12 col-lg-12 col-md-12 mb-1">
                    <p class="h4" id="Body"></p>
                </div>
            </div>
            <div class="col-xl-12 col-lg-12 col-md-12 mb-1">
                <div>
                    <div id="FileDocuments" style="padding:5px;width:80%;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div style="background-color:#fff" class="panel-footer">
    <div class="coment-form mt-2">
        <h4 class="m-2">
            <i class="bi bi-person-arms-up"></i>
        </h4>
        <div>
            <p>پیش از ثبت نظر وارد حساب کاربری خود شوید</p>
            <div id="Comment">
                <textarea id="Comment_Text" placeholder="نظر من ..."></textarea>
            </div>
            <input onclick="CreateComment()" type="submit" value="ثبت نظر">
        </div>
    </div>
    <br />
    <div class="response">
        <h4>نظرات</h4>
        <div id="CommentsViwe"></div>
    </div>
</div>


@section Modals {
<div class="modal fade in" id="exampleModalCenter" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document" style="margin-top:20%;">
        <div class="modal-content" style="background-color:#fff">
            @*<div class="modal-header"></div>*@
            <div class="modal-body">
                <button type="button" style="color:red" class="close" data-dismiss="modal" aria-label="Close" onclick="$('#exampleModalCenter').modal('hide')">
                    <span aria-hidden="true">&times;</span>
                </button>
                <br />
                <div style="position: relative;padding: 4%;">
                    <div onmouseout="ReStart()" style="padding:1%;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);">
                        <i id="1" onclick="SetRateModal(1)" class="fa-regular fa-star star-rate" aria-hidden="true" style="color:#1e1edf;font-size:x-large;"></i>
                        <i id="2" onclick="SetRateModal(2)" class="fa-regular fa-star star-rate" aria-hidden="true" style="color:#1e1edf;font-size:x-large;"></i>
                        <i id="3" onclick="SetRateModal(3)" class="fa-regular fa-star star-rate" aria-hidden="true" style="color:#1e1edf;font-size:x-large;"></i>
                        <i id="4" onclick="SetRateModal(4)" class="fa-regular fa-star star-rate" aria-hidden="true" style="color:#1e1edf;font-size:x-large;"></i>
                        <i id="5" onclick="SetRateModal(5)" class="fa-regular fa-star star-rate" aria-hidden="true" style="color:#1e1edf;font-size:x-large;"></i>
                    </div>
                </div>
            </div>
            <div class="" style="position: relative;padding: 4%;">
                <button onclick="SetRate()" type="button" style="padding:1%;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);" class="btn btn-success">ثبت رای</button>
            </div>
        </div>
    </div>
</div>
}

@section Scripts {
<script>
    var Titel = "";
    var recordCount = 10;
    var pageSize = 5;
    var page = 1;
    GetNews();
    GetCamments(page);


    function GetCamments(page){
        postdata = {
            'Id' : @Model,
            'Page' : page,
            'PageSize' : pageSize,
        }

        var url = 'GetCamments';
        $.post(url, postdata, function(result){
            setPagination(result.recordCount,10,page);
            var html = "";
            for(var i = 0; i <result.list.length; i++){
                html+=`<div id="Comment_${result.list[i].id}" style="background-color: rgb(199 196 196 / 40%);padding:2%;border:1px ridge #fffafa;"class="media response-info">
                          <div class="row">
                             <div class="col-1 col-sm-1 col-md-1 col-sm-1 col-lg-1 col-xl-1 col-xxl-1">`;
                             if (result.list[i].userImage != null) { html+=`<img style="border-radius:50%;text-align:center; height:50px; width:50px" class="avator media-object" src="/FileDacuments/GenerateFile?fileDocumentId=${result.list[i].userImage}" alt="">`; }
                             else{ html+=`<img class="avator" style="border-radius:50%;text-align:center; height:50px; width:50px" src="/Express_New/images/no-image.png" style="text-align:center;height:100%;width:100%"/>`; }
                             html+=`</div>
                             <div class="col-8 col-sm-8 col-md-8 col-sm-8 col-lg-8 col-xl-8 col-xxl-8">
                                <label>${result.list[i].userName}</label>
                             </div>
                             <div class="col-3 col-sm-3 col-md-3 col-sm-3 col-lg-3 col-xl-3 col-xxl-3">
                                ${result.list[i].insertTime}
                             </div>
                          </div>
                          <div class="response-text">
                             <p style="padding:2%;" id="P${result.list[i].id}">${result.list[i].text}</p>
                             <div class="row">
                             <a class="col-12 col-sm-12 col-md-12 col-sm-12 col-lg-12 col-xl-12 col-xxl-12 link-underline-opacity-0 link-opacity-25-hover" onclick="ShowReplyTextArea('#Reply_Comment_${result.list[i].id}')">پاسخ</a>
                             <dev class="col-12 col-sm-12 col-md-12 col-sm-12 col-lg-12 col-xl-12 col-xxl-12 Reply p-2 row" id="Reply_Comment_${result.list[i].id}">
                                <textarea rows="5" style="margin: 0 15px;width:100%;background-color:rgb(240 240 240 / 80%);" id="Reply_Comment_Text_${result.list[i].id}" class="coment-form" placeholder="نظر من ..."></textarea>
                                <input style="margin: 0 15px;" class="col-12 col-sm-12 col-md-12 col-sm-12 col-lg-12 col-xl-12 col-xxl-12" onclick="CreateReplyComment(${result.list[i].id}, ${result.list[i].id})" type="submit" value="ثبت نظر">
                             </dev>
                          </dev>`;
                          if(result.list[i].repComment.length > 0) {
                          html+=`<div>`;
                             for(var j = 0; j < result.list[i].repComment.length; j++){
                             html+=`<div id="Comment_${result.list[i].repComment[j].id}" style="margin-top:25%;background-color: rgb(0 0 0 / 5%);border:1px ridge #ddd;padding:2%;margin:2%;" class="media response-info">
                                <div class="row"><div class="col-1 col-sm-1 col-md-1 col-sm-1 col-lg-1 col-xl-1 col-xxl-1">`;
                                if (result.list[i].repComment[j].userImage != null) { html+=`<img style="border-radius:50%;text-align:center; height:50px; width:50px" class="avator media-object" src="/FileDacuments/GenerateFile?fileDocumentId=${result.list[i].repComment[j].userImage}" alt="">`; }
                                else{ html+=`<img class="avator" style="border-radius:50%;text-align:center; height:50px; width:50px" src="/Express_New/images/no-image.png" style="text-align:center;height:100%;width:100%"/>`; }
                             html+=`</div>
                             <div class="col-8 col-sm-8 col-md-8 col-sm-8 col-lg-8 col-xl-8 col-xxl-8">
                                <label>${result.list[i].userName}</label>
                             </div>
                             <div class="col-3 col-sm-3 col-md-3 col-sm-3 col-lg-3 col-xl-3 col-xxl-3">
                                ${result.list[i].insertTime}
                                <a href="#Comment_${result.list[i].repComment[j].parentId}" onclick="ReadParent('#Comment_${result.list[i].repComment[j].parentId}')">
                                   <i class="fa fa-share-square" aria-hidden="true"></i>
                                </a>

                             </div>
                                <div class="response-text">
                                   <p style="padding:2%;" id="P${result.list[i].repComment[j].id}">${result.list[i].repComment[j].text}</p>
                                   <a class="col-12 col-sm-12 col-md-12 col-sm-12 col-lg-12 col-xl-12 col-xxl-12 link-underline-opacity-0 link-opacity-25-hover" onclick="ShowReplyTextArea('#Reply_Comment_${result.list[i].repComment[j].id}')">پاسخ</a>
                                   <dev class="col-12 col-sm-12 col-md-12 col-sm-12 col-lg-12 col-xl-12 col-xxl-12 Reply p-2 row" id="Reply_Comment_${result.list[i].repComment[j].id}">
                                      <textarea rows="5" style="margin: 0 15px;width:100%;background-color:rgb(240 240 240 / 80%);" id="Reply_Comment_Text_${result.list[i].repComment[j].id}" class="coment-form" placeholder="نظر من ..."></textarea>
                                      <input style="margin: 0 15px;width:100%;" onclick="CreateReplyComment(${result.list[i].repComment[j].id}, ${result.list[i].id})" type="submit" value="ثبت نظر">
                                   </div>
                                </div>
                                <div class="clearfix"></div>
                             </div>`;
                             }
                          }
                          html+=`</div>
                        <div class="clearfix"></div>
                     </div>
                  </div>
               </div>`;
            }
            $("#CommentsViwe").empty();
            $("#CommentsViwe").append(html);
        });
    }


    function setPagination(recordCount, itemsOnPage, currentPage){
        var items = ( recordCount / 5 );
        $("#paginate").pagination({
            items: items,
            itemsOnPage: 1,
            currentPage: currentPage,
            cssStyle: 'light-theme',
            prevText: "قبلی",
            nextText: "بعدی",
            onPageClick : function(pageNumbner, event){
                page=pageNumbner;
                Getcamments(page);
            },
        });
        var text = "<p> نمایش " + (itemsOnPage*(currentPage-1)+1)+" تا ";
        text += (itemsOnPage*currentPage) > recordCount ? recordCount : (itemsOnPage*currentPage);
        text += " از "+recordCount+"سطر <p>";
        $("#text_shit").html(text);
    }

    var starnumber = 0;
    function GetNews(){
        var url = 'GetNews';
        $.post(url, { id : @Model }, function(result){
             if(result.isSuccess){
                    $('#DefaultImage').attr('src',`/FileDacuments/GenerateFile?fileDocumentId=${result.data.defaultImageId}`);
                    if(result.data.defaultImageId == null) {$('#DefaultImage').hide(); }
                    $('#Title').text(`${result.data.title}`);
                    $('#Headline').text(`${result.data.headline}`);
                    $('#Body').html(`${result.data.body.replaceAll('\n', '<br>')}`);
                    $('#InsertTime').text(`${result.data.EditTime ?? result.data.insertTime}`);
                    $('#Rateing').text(`${result.data.rate}`);
                    $('#LikeCount').text(`${result.data.likeCount} نفر/`);
                    $('#CategoryTitle').text(`${result.data.categoryTitle}`);
                    $('#CategoryTitle').attr("href", `/Home/Service?by=${result.data.categoryName}`)
                    $('#FileDocuments').empty();

                    if(result.data.userRate != null){
                        $('#MyRate').text(`${result.data.userRate}`);
                        $(`#SolidStar`).removeClass('fa-regular');
                        $(`#SolidStar`).addClass('fa-solid');
                        starnumber = result.data.userRate;
                    }

                    for(let i = 0; i < result.data.imagesId.length; i++)
                    {
                        if(result.data.defaultImageId != result.data.imagesId[i])
                        GetImages(result.data.imagesId[i]);
                    }
                }
                else{
                    swal.fire('هشدار',result.message,'warning');
                }
        });
    }


    function CreateComment(){
        var postdata = {
            'NewsId' : @Model,
            'Text' : $('#Comment_Text').val(),
        };

        var url = "CreateCamments";
        $.post(url, postdata, function(result){
            if(result.isSuccess){
                swal.fire('موفق',result.message,'success').
                    then(function (isConfirm){
                    GetCamments(page, pageSize);
                });
            }
            else{
                swal.fire({
                titel: 'هشدار',
                text: result.message,
                icon: 'info',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#84754e',
                confirmButtonText: 'ورود به حساب کاربری',
                cancelButtonText: 'بعدا'
            })
            .then((result) => {
                if(result.value) {
                    window.location.href = `/authentication/signin?ReturnUrl="${window.location.href}"`;
                 }
            });
            }
        });
    }


    function ReadParent(el){
        debugger
        $(el).animate({opacity: '0.3'}, 50);
        $(el).animate({opacity: '1'}, 2000);
    }


    function CanselReplyComment(id){
        $(id).slideUp(500);
    }


    function ShowReplyTextArea(id){
        $(`.Reply:not(${id})`).slideUp(500);
        $(id).slideToggle(500);
    }


    function CreateReplyComment(ParentId, RootId){
        var postdata = {
            'NewsId' : @Model,
            'ParentId' : ParentId,
            'RootId' : RootId,
            'Text' : $(`#Reply_Comment_Text_${ParentId}`).val(),
        };

        var url = "CreateCamments";
        $.post(url, postdata, function(result){
            if(result.isSuccess){
                swal.fire('موفق',result.message,'success').
                    then(function (isConfirm){
                    GetCamments(page, pageSize);
                });
            }
            else{
                swal.fire({
                titel: 'هشدار',
                text: result.message,
                icon: 'info',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#84754e',
                confirmButtonText: 'ورود به حساب کاربری',
                cancelButtonText: 'بعدا'
            })
            .then((result) => {
                if(result.value) {
                    window.location.href = `/authentication/signin?ReturnUrl="${window.location.href}"`;
                 }
            });
            }
        });
    }


    function GetImages(id){
        var img = "";
        img += `<div style="float:left; position:relative; margin-top:1%;width:80%;overflow:hidden;">
            <img onclick="/FileDacuments/GenerateFile?fileDocumentId=${id}" target="_blank"src="/FileDacuments/GenerateFile?fileDocumentId=${id}"
        class="img-thumbnail rounded mx-auto"style="text-align: center;height:100%;width:100%"></div>`;
        $('#FileDocuments').append(img);
    }


    ////////////////// star /////////////////////

    function ShowRateModal(){
            for(let i = 1; i <= starnumber; i++){
                $(`#${i}`).removeClass('fa-regular');
                $(`#${i}`).addClass('fa-solid');
            }
            for(let i = Number(starnumber) +1; i <= 5; i++){
                $(`#${i}`).removeClass('fa-solid');
                $(`#${i}`).addClass('fa-regular');
            }
            starnumber = 0;
            $('#exampleModalCenter').modal('show');
    }


    function SetRateModal(id){
            for(let i = 1; i <= id; i++){
                $(`#${i}`).removeClass('fa-regular');
                $(`#${i}`).addClass('fa-solid');
            }
            starnumber = id;
            ReStart();
    }


    function ReStart(){
            for(let i = Number(starnumber) + 1; i <= 5; i++){
                $(`#${i}`).removeClass('fa-solid');
                $(`#${i}`).addClass('fa-regular');
            }
    }


    function SetRate(){
            let postdata = {
                'UserRete' : starnumber,
                'NewsId' : @Model,
            };
            let url = "SetRate";
            $.post(url, postdata, function(result){

                if(result.isSuccess){
                    $(`#SolidStar`).removeClass('fa-regular');
                    $(`#SolidStar`).addClass('fa-solid');
                    $(`#MyRate`).text(`${starnumber}`);
                    $(`#Rateing`).text(`${result.data.rate}`);
                    $(`#LikeCount`).text(`${result.data.count} نفر/`);
                    $('#exampleModalCenter').modal('hide');
                }
                else{
                    swal.fire('هشدار',result.message,'warning');
                    $('#exampleModalCenter').modal('hide');
                }
            })
    }

</script>
    }
