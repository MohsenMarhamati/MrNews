@model string

@{
    ViewData["Title"] = Model;
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

<div>
    <header>
        <ol class="breadcrumb col-xl-12 col-lg-12 col-md-12 mb-1">
            <li><a href="/">صفحه اصلی</a></li>
            <li class="active"><a id="CategoryTitle"></a></li>
        </ol>
    </header>
    <div class="articles sports">
        <div id="NewsBode"></div>
        <div class="row">
            <div class="col-sm-12 col-md-5">
                <div class="dataTables_info" id="text_shit" role="status" aria-live="polite">
                </div>
            </div>
            <div class="col-sm-12 col-md-7">
                <div class="dataTables_paginate paging_simple_numbers" id="paginate"></div>
            </div>
        </div>
    </div>
</div>



<div class="modal fade in" id="exampleModalCenter" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document" style="margin-top:20%;">
        <div class="modal-content" style="background-color:#fff">
            @*<div class="modal-header"></div>*@
            <div class="modal-body">
                <button type="button" style="color:red" class="close" data-dismiss="modal" aria-label="Close" onclick="$('#exampleModalCenter').modal('hide')">
                    <span aria-hidden="true">&times;</span>
                </button>
                <br />
                <div style="position: relative;padding: 4%;">
                    <div onmouseout="ReStart()" style="padding:1%;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);">
                        <i id="1" onclick="SetRateModal(1)" class="fa-regular fa-star star-rate" aria-hidden="true" style="color:#1e1edf;font-size:x-large;"></i>
                        <i id="2" onclick="SetRateModal(2)" class="fa-regular fa-star star-rate" aria-hidden="true" style="color:#1e1edf;font-size:x-large;"></i>
                        <i id="3" onclick="SetRateModal(3)" class="fa-regular fa-star star-rate" aria-hidden="true" style="color:#1e1edf;font-size:x-large;"></i>
                        <i id="4" onclick="SetRateModal(4)" class="fa-regular fa-star star-rate" aria-hidden="true" style="color:#1e1edf;font-size:x-large;"></i>
                        <i id="5" onclick="SetRateModal(5)" class="fa-regular fa-star star-rate" aria-hidden="true" style="color:#1e1edf;font-size:x-large;"></i>
                    </div>
                </div>
            </div>
            <div class="" style="position: relative;padding: 4%;">
                <button onclick="SetRate()" type="button" style="padding:1%;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);" class="btn btn-success">ثبت رای</button>
            </div>
        </div>
    </div>
</div>



@section Scripts {
<script>

    var recordCount = 10;
    var page = 1;
    GetNewsByModel(page);

    function setPagination(recordCount, itemsOnPage, currentPage){
        var items = ( recordCount / 10 );
        $("#paginate").pagination({
            items: items,
            itemsOnPage: 1,
            currentPage: currentPage,
            cssStyle: 'light-theme',
            prevText: "قبلی",
            nextText: "بعدی",
            onPageClick : function(pageNumbner, event){
                page=pageNumbner;
                GetNewsByModel(page);
                topFunction();
            },
        });
        var text = "<p> نمایش " + (itemsOnPage*(currentPage-1)+1)+" تا ";
        text += (itemsOnPage*currentPage) > recordCount ? recordCount : (itemsOnPage*currentPage);
        text += " از "+recordCount+"خبر <p>";
        $("#text_shit").html(text);
    }


    function GetNewsByModel(page){
        $("#NewsBode").empty();
        let postdata = {
            'Category' : '@Model',
            'Page' : page,
            'PageSize' : 10
        };

        let url = 'GetNewsByModel';
        $.post(url, postdata, function(result){
            $('#CategoryTitle').text(`${result.data.list[0].categoryTitle}`);
            $('#CategoryTitle').attr("href", `/Home/Service?by=@Model`)
            setPagination(result.data.recordCount,10,page);
            var html = "";
            for(var i = 0; i <result.data.list.length; i++){
                html+=`<div class="article">
                    <div class="article-right image-effect">
                    <a href="/MrNews/Page?id=${result.data.list[i].id}">`;
                    if (result.data.list[i].defaultImageId != null ){
                        html+=`<img style="max-height:300px;" src="/FileDacuments/GenerateFile?fileDocumentId=${result.data.list[i].defaultImageId}">`;
                    }
                    else{
                        html+=`<img src="/Express_New/images/no-image.png" style="max-height:300px; text-align:center; height:100%; width:100%"/>`;
                    }
                    html+=`</a></div>
                    <div class="article-left">
                        <div class="article-title row">
                            <p class="col-6 col-sm-6 col-md-6 col-sm-6 col-lg-6 col-xl-6 col-xxl-6">${result.data.list[i].insertTime}</p>
                            <div style="text-align:left;padding-left:5%;" class="col-6 col-sm-6 col-md-6 col-sm-6 col-lg-6 col-xl-6 col-xxl-6">
                                <div class="row">
                                    <div class="col-6 col-sm-6 col-md-6 col-sm-6 col-lg-6 col-xl-6 col-xxl-6">
                                        <button class="btn" style="background-color:#fff;" onclick="ShowRateModal(${result.data.list[i].id})">`
                                            html+=`<span id="MyRate_${result.data.list[i].id}" style="font-size:xx-large;">${result.data.list[i].userRate ?? ''}</span>`
                                        if(result.data.list[i].userRate != null){
                                            html+=`<i id="star_${result.data.list[i].id}" class="fa-solid fa-star" aria-hidden="true" style="color:#101edf;font-size:x-large;"></i>`
                                        }
                                        else{
                                            html+=`<i id="star_${result.data.list[i].id}" class="fa-regular fa-star" aria-hidden="true" style="color:#101edf;font-size:x-large;"></i>`
                                        }
                                        html+=`</button>
                                    </div>
                                    <div class="col-6 col-sm-6 col-md-6 col-sm-6 col-lg-6 col-xl-6 col-xxl-6">
                                        <span id="LikeCount_${result.data.list[i].id}">${result.data.list[i].likeCount} نفر/</span>
                                        <span id="Rate_${result.data.list[i].id}" style="font-size:xx-large;">${result.data.list[i].rating}</span>
                                        <i class="fa-solid fa-star" aria-hidden="true" style="color:#ffd600;font-size:x-large;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <a class="title" href="/MrNews/Page?id=${result.data.list[i].id}">  ${result.data.list[i].title}</a>
                        <div class="article-text">
                            <a class="title" href="/MrNews/Page?id=${result.data.list[i].id}">
                                <p style='font-size:0.6em'>  ${result.data.list[i].headline.replaceAll('\n', '<br>')}</p>
                            </a>
                            <div class="clearfix"></div>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                 </div><br/>`;
             }
             $("#NewsBode").append(html);
        });
    }


    var NewsId;
    function ShowRateModal(id){
        debugger
        starnumber = $(`#MyRate_${id}`).text();
        for(let i = 1; i <= starnumber; i++){
            $(`#${i}`).removeClass('fa-regular');
            $(`#${i}`).addClass('fa-solid');
        }
        for(let i = Number(starnumber) +1; i <= 5; i++){
            $(`#${i}`).removeClass('fa-solid');
            $(`#${i}`).addClass('fa-regular');
        }
        NewsId = id;
        starnumber = 0;
        $('#exampleModalCenter').modal('show');
    }


    var starnumber = 0;
    function SetRateModal(id){
        for(let i = 1; i <= id; i++){
            $(`#${i}`).removeClass('fa-regular');
            $(`#${i}`).addClass('fa-solid');
        }
        starnumber = id;
        ReStart();
    }


    function ReStart(){
        for(let i = Number(starnumber) + 1; i <= 5; i++){
            $(`#${i}`).removeClass('fa-solid');
            $(`#${i}`).addClass('fa-regular');
        }
    }


    function SetRate(){
        let postdata = {
            'UserRete' : starnumber,
            'NewsId' : NewsId,
        };
        let url = "SetRate";
        $.post(url, postdata, function(result){

            if(result.isSuccess){
                $(`#star_${NewsId}`).removeClass('fa-regular');
                $(`#star_${NewsId}`).addClass('fa-solid');
                $(`#Rate_${NewsId}`).text(`${result.data.rate}`);
                $(`#Rate_${NewsId}`).text(`${result.data.rate}`);
                $(`#MyRate_${NewsId}`).text(`${starnumber}`);
                $(`#LikeCount_${NewsId}`).text(`${result.data.count} نفر/`);
                $('#exampleModalCenter').modal('hide');
            }
            else{
                swal.fire('هشدار',result.message,'warning');
                $('#exampleModalCenter').modal('hide');
            }
        })
    }

</script>
}