    <style>
        .ticker {
            white-space: nowrap;
        }

        .item {
            display: inline-block;
            cursor: pointer;
            direction: rtl;
            font-size: 10px;
        }

        .image-effect {
            overflow: hidden;
            -webkit-transition: 0.5s all;
            -moz-transition: 0.5s all;
            -o-transition: 0.5s all;
            -ms-transition: 0.5s all
        }

            .image-effect:hover img {
                transform: scale(1.2,1.2);
                opacity: .2;
                -webkit-transition: 0.5s all;
                -moz-transition: 0.5s all;
                -o-transition: 0.5s all;
                -ms-transition: 0.5s all;
            }

        .container {
            position: relative;
        }

        .topleft {
            position: absolute;
            top: 8px;
            left: 16px;
            font-size: 18px;
