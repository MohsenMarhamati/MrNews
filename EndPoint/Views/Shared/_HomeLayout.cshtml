<script type="text/javascript">
    jQuery(document).ready(function($) {
        $(".scroll").click(function(event){
            event.preventDefault();
            $('html,body').animate({scrollTop:$(this.hash).offset().top},900);
        });
    });
</script>
<script>
    $('.marquee').marquee({ pauseOnHover: true });
</script>

<script>

    function GoToLogIn(){
        window.location.href = `/authentication/signin?ReturnUrl="${window.location.href}"`
    }

    function GoToSingUp(){
        window.location.href = `/authentication/signup?ReturnUrl="${window.location.href}"`
    }

    function GoToProfileEdit(){
        window.location.href = `/authentication/Edit?ReturnUrl="${window.location.href}"`
    }

    function SignOut(){
        window.location.href = `/authentication/signout?ReturnUrl="${window.location.href}"`
    }

    function topFunction() {
        document.body.scrollTop = 0;
        document.documentElement.scrollTop = 0;
    }


    LatesCamment();
    GetRightNews();
    GetCategories();
    GetMostPopular();
    OupLoadLatestNews();
    HeaderGetCategories();

    function OupLoadLatestNews(){
        let url = "/Home/LatestNews";
        $.post(url,function(result){
            if(result.isSuccess){
                let html = "";
                for(let i = 0; i < result.data.length; i++){
                    html+=`<div class="item"> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <a class="title" href="/MrNews/Page?id=${result.data[i].id}"> « ${result.data[i].title} » </a> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </div>`;
                }
                $('#LatestNews').append(html);
            }
            else{

            }
        });
    }


    function GetCategories(){
        let url = "/Home/GetCategories";
        $.post(url, function(result){
            if(result.isSuccess){
                let html = "";
                for(let i = 0; i < result.data.length; i++){
                    html +=`
                    <div class="popular-post-grid">
                        <div class="post-img" style="height:100px;width:100px;overflow:hidden">
                            <a target="_blank" href="/Home/Service?by=${result.data[i].name}">
                                <img style="width:100%;height:100%;object-fit:cover;" src="/FileDacuments/GenerateFile?fileDocumentId=${result.data[i].fileDocumentId}"/>
                            </a>
                        </div>
                        <div class="post-text">
                            <a class="pp-title" target="_blank" href="/Home/Service?by=${result.data[i].name}">${result.data[i].title}</a>
                            <p>تعداد خبر های این گروه خبری : ${result.data[i].number}</p>
                        </div>
                        <div class="clearfix"></div>
                    </div>
                    `;
                }
                $('#Categories_list').append(html);
            }
        })
    }


    function HeaderGetCategories(){
        let url = "/Home/GetCategories";
        $.post(url, function(result){
            if(result.isSuccess){
                let html = "";
                for(let i = 0; i < result.data.length; i = i + 2){
                    html +=`<li><a target="_blank" href="/Home/Service?by=${result.data[i].name}">${result.data[i].title}</a></li>`;
                    if(i+2 < result.data.length) {html +=`<li class="divider"></li>`}
                }
                $('#Categoriescolumn1').append(html);

                html = "";
                for(let i = 1; i < result.data.length; i = i + 2){
                    html +=`<li><a target="_blank" href="/Home/Service?by=${result.data[i].name}">${result.data[i].title}</a></li>`;
                    if(i+2 < result.data.length) {html +=`<li class="divider"></li>`}
                }
                $('#Categoriescolumn2').append(html);
            }
        })
    }


    function LatesCamment(){
        let url = "/Home/LatesCamment";
        $.post(url, function(result){
            if(result.isSuccess){
                let html = "";
                for(let i = 0; i < result.data.length; i++){
                    html +=`
                    <div class="media response-info">
                        <div class="media-right response-text-right">`
                            if (result.data[i].userImage != null ){
                               html+=`<img style="border-radius:50%;text-align:center; height:50px; width:50px" class="media-object" src="/FileDacuments/GenerateFile?fileDocumentId=${result.data[i].userImage}">`;
                            }
                            else{
                               html+=`<img class="media-object avator" src="/Express_New/images/no-image.png" style="text-align:center; height:100%; width:100%"/>`;
                            }
                            html +=`
                            <h5>${result.data[i].userName}</h5>
                        </div>
                        <div class="media-body response-text-left">
                            <p>${result.data[i].text}</p>
                            <ul>
                                <li>${result.data[i].insertTime}</li>
                                <li><a href="/MrNews/Page?id=${result.data[i].newsId}">نمایش خبر</a></li>
                            </ul>
                        </div>
                        <div class="clearfix"> </div>
                    </div>
                    `;
                }
                $('#Comments_List').append(html);
            }
        });
    }


    function GetMostPopular(){
        let url = "/Home/GetMostPopular";
        $.post(url, function(result){
            if(result.isSuccess){
                let html = "";
                for(let i = 0; i < result.data.length; i++){
                    html +=`
                    <div class="popular-post-grid">
                        <div style="height:100px;width:100px;overflow:hidden" class="post-img">
                            <a href="/MrNews/Page?id=${result.data[i].id}">
                                <img style="width:100%;height:100%;object-fit:cover;" src="/FileDacuments/GenerateFile?fileDocumentId=${result.data[i].defaultImageId}" alt="نماییه ای برای این خبر وجود ندارد" />
                            </a>
                        </div>
                        <div class="post-text media-body response-text-left"">
                            <a class="pp-title" href="/MrNews/Page?id=${result.data[i].id}">${result.data[i].title}</a>
                            <ul>
                            <li>
                                <span style="color:black;">${result.data[i].likeCount} نفر/</span>
                                <span style="color:black; font-size:xx-large;">${result.data[i].rating}</span>
                                <i class="fa-solid fa-star" aria-hidden="true" style="color:#ffd600;font-size:x-large;"></i>
                            </li>
                                <li>${result.data[i].insertTime}</li>
                                <li><a href="/MrNews/Page?id=${result.data[i].id}">نمایش خبر</a></li>
                            </ul>
                        </div>
                        <div class="clearfix"></div>
                    </div>
                    `;
                }
                $('#MostPopular_List').append(html);
            }
        })
    }


    function GetRightNews(){
        let url = "/Home/GetNews8";
        $.post(url, function(result){
            let html = '';
            for(var i = 0; i < result.data.length; i++){
                html+=`
                <div class="side-bar-article">
                    <a href="/MrNews/Page?id=${result.data[i].id}">
                        <img src="/FileDacuments/GenerateFile?fileDocumentId=${result.data[i].defaultImageId}"/>
                    </a>
                    <div class="side-bar-article-title">
                        <a href="/MrNews/Page?id=${result.data[i].id}">  ${result.data[i].title}</a>
                    </div>
                </div>
                `;
            }
            $('#NewsOnTheRight').append(html);
        })
    }

</script>

@RenderSection("Scripts", required:false)

